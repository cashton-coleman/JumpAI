{
  "name": "bench.agent-audit",
  "version": "1.0.1",
  "purpose": "Collect native whole-agent usage, model exchanges and task time; audit exact source restoration and selected tests in independent copies",
  "runtime": "python",
  "entrypoint": "main.py",
  "files": [
    "main.py"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "output_dir": {
        "type": "string",
        "minLength": 1
      },
      "sessions_dir": {
        "type": "string",
        "minLength": 1
      },
      "parent_thread_id": {
        "type": "string",
        "minLength": 1
      },
      "conditions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "output_dir",
      "sessions_dir",
      "parent_thread_id",
      "conditions"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object"
  },
  "timeout_seconds": 120
}
