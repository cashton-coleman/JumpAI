{
  "name": "tests.summarize-run",
  "version": "1.0.1",
  "kind": "program",
  "purpose": "Summarize unittest outcome records and list failures and slowest tests",
  "use_cases": [
    "Summarize a real test run from JSON"
  ],
  "tags": [
    "tests",
    "summarize-run"
  ],
  "runtime": "python",
  "entrypoint": "main.py",
  "files": [
    "main.py"
  ],
  "timeout_seconds": 30,
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "top": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object"
  }
}
