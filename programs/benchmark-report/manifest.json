{
  "name": "bench.render-report",
  "version": "1.1.1",
  "purpose": "Render completed native agent benchmarks with medians, explicit per-worker audit outcomes and human source-read annotations, retaining failed repairs",
  "runtime": "python",
  "entrypoint": "main.py",
  "files": [
    "main.py",
    "render.py"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "output_dir": {
        "type": "string",
        "minLength": 1
      },
      "conditions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "reference_condition": {
        "type": "string",
        "minLength": 1
      },
      "labels": {
        "type": "object"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "context": {
        "type": "string"
      },
      "notes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "output_dir",
      "conditions",
      "reference_condition",
      "labels",
      "title",
      "context",
      "notes"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object"
  },
  "timeout_seconds": 30
}
