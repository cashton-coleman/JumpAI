{
  "name": "repo.evaluate-agent-benchmark",
  "version": "1.1.1",
  "kind": "workflow",
  "purpose": "Collect and audit completed native agent benchmarks, then conditionally render a compact report without repeated model orchestration",
  "input_schema": {
    "type": "object",
    "properties": {
      "audit": {
        "type": "object",
        "properties": {
          "output_dir": {
            "type": "string",
            "minLength": 1
          },
          "sessions_dir": {
            "type": "string",
            "minLength": 1
          },
          "parent_thread_id": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "output_dir",
          "sessions_dir",
          "parent_thread_id",
          "conditions"
        ],
        "additionalProperties": false
      },
      "report": {
        "type": "object",
        "properties": {
          "reference_condition": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "object"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "reference_condition",
          "labels",
          "title",
          "context",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "audit",
      "report"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object"
  },
  "steps": [
    {
      "name": "audit",
      "target": "bench.agent-audit@1.0.1",
      "bindings": {
        "output_dir": {
          "input": "/audit/output_dir"
        },
        "sessions_dir": {
          "input": "/audit/sessions_dir"
        },
        "parent_thread_id": {
          "input": "/audit/parent_thread_id"
        },
        "conditions": {
          "input": "/audit/conditions"
        }
      }
    },
    {
      "name": "report",
      "target": "bench.render-report@1.1.1",
      "when": {
        "value": {
          "step": "audit",
          "pointer": "/ready"
        },
        "equals": true
      },
      "otherwise": {
        "step": "audit",
        "pointer": ""
      },
      "bindings": {
        "reference_condition": {
          "input": "/report/reference_condition"
        },
        "labels": {
          "input": "/report/labels"
        },
        "title": {
          "input": "/report/title"
        },
        "context": {
          "input": "/report/context"
        },
        "notes": {
          "input": "/report/notes"
        },
        "output_dir": {
          "input": "/audit/output_dir"
        },
        "conditions": {
          "input": "/audit/conditions"
        }
      }
    }
  ],
  "output": {
    "step": "report",
    "pointer": ""
  },
  "summary": {
    "step": "report",
    "pointer": ""
  }
}
