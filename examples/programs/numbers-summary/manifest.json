{
  "name": "numbers.summary",
  "version": "1.0.1",
  "kind": "program",
  "purpose": "Compute count, minimum, maximum, mean and median of a numeric record field",
  "use_cases": [
    "Summarize benchmark durations",
    "Describe numeric measurements"
  ],
  "tags": [
    "statistics",
    "summary",
    "numbers",
    "benchmark"
  ],
  "runtime": "python",
  "entrypoint": "main.py",
  "files": [
    "main.py"
  ],
  "arguments": [],
  "timeout_seconds": 10,
  "input_schema": {
    "type": "object",
    "properties": {
      "records": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "minItems": 1
      },
      "field": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "records",
      "field"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 1
      },
      "min": {
        "type": "number"
      },
      "max": {
        "type": "number"
      },
      "mean": {
        "type": "number"
      },
      "median": {
        "type": "number"
      }
    },
    "required": [
      "count",
      "min",
      "max",
      "mean",
      "median"
    ],
    "additionalProperties": false
  }
}
