{
  "name": "records.select",
  "version": "1.0.1",
  "kind": "program",
  "purpose": "Select named fields from JSON records",
  "use_cases": [
    "Project columns before analysis",
    "Remove irrelevant fields"
  ],
  "tags": [
    "records",
    "fields",
    "project"
  ],
  "runtime": "python",
  "entrypoint": "main.py",
  "files": [
    "main.py"
  ],
  "arguments": [],
  "timeout_seconds": 10,
  "input_schema": {
    "type": "object",
    "properties": {
      "records": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "fields": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "records",
      "fields"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "records": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "required": [
      "records"
    ],
    "additionalProperties": false
  }
}
